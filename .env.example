NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (chatbot + AI Insights)
# Prefer free Gemini from Google AI Studio:
# https://aistudio.google.com/apikey
# Keep these server-side only. Never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini model (default: gemini-3.5-flash-lite for speed)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback (used only if Gemini key is missing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
